# Deployment provider selectors. Required in Preview/Production; local development and tests
# preserve the Global matrix only when all selectors are omitted.
APP_REGION=global
DATA_PROVIDER=supabase
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
NEXT_PUBLIC_MAPS_PROVIDER=google

# Global Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://example.com

# Global Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Places API (New), server only — optional public place photos
GOOGLE_PLACES_API_KEY=

# Google Routes API (Phase 4, server only — never prefix this with NEXT_PUBLIC_)
GOOGLE_ROUTES_API_KEY=

# Global server/admin entrypoints only. Ordinary builds do not require these secrets.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# CloudBase Phase 2 management target identifiers (not secrets). These are consumed only by
# the checked-in baseline tooling; Global builds do not require them. The free PG instance does
# not provide an unattended direct migration credential, so no migration URL belongs here.
CLOUDBASE_ENV_ID=trip-planner-cn-dev-d3bz94038b26
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_PG_INSTANCE_ID=pgdb-l4lhtrv7
# Do not supply Supabase credentials to a CN deployment as a fallback.

# Provider-neutral telemetry
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TELEMETRY_PROVIDER=posthog
NEXT_PUBLIC_TELEMETRY_REGION=global
NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development

# PostHog browser and server ingestion
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog UI/build configuration
POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# Pseudonymous identity (server only)
TELEMETRY_ID_HMAC_SECRET=

# Preview-only acceptance endpoint (server only)
TELEMETRY_SMOKE_TEST_ENABLED=false
TELEMETRY_SMOKE_TEST_TOKEN=
