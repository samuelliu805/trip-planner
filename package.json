{
  "name": "trip-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backfill:place-localities": "node --use-env-proxy --env-file=.env.local scripts/backfill-place-localities.ts",
    "build:public-templates": "node scripts/build-public-templates.mjs",
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "check:auth-routes": "node scripts/check-auth-routes.mjs",
    "check:backend-provider-boundary": "node scripts/check-backend-provider-boundary.ts",
    "check:build-secret-boundary": "node scripts/check-build-secret-boundary.mjs",
    "check:build-provider-isolation": "node scripts/check-build-provider-isolation.mjs",
    "check:cloudbase-pg-baseline": "node scripts/cloudbase-pg-baseline.mjs check",
    "check:cloudbase-pg-rpc-surface": "node scripts/cloudbase-pg-rpc-surface.mjs check",
    "check:cloudbase-pg-target": "node scripts/cloudbase-pg-target.mjs",
    "check:database-pg-migrations": "node scripts/database-pg-migrations.mjs check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:maps-provider-boundary": "node scripts/check-maps-provider-boundary.ts",
    "check:phase-5-environment": "node scripts/phase-5-environment.mjs",
    "cloudbase:baseline:check": "npm run check:cloudbase-pg-baseline",
    "cloudbase:database-migrations:check": "npm run check:database-pg-migrations",
    "cloudbase:rpc:compat": "npm run check:cloudbase-pg-rpc-surface",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "npm run validate:public-templates",
    "prepare:cloudbase-run": "node scripts/prepare-cloudbase-run.mjs",
    "test": "node scripts/run-compact-command.mjs --label \"unit and contract tests\" -- npm run test:verbose",
    "test:verbose": "node src/features/itinerary/itinerary.test.ts && node --test src/features/auth/phone.test.ts src/features/i18n/config.test.ts src/lib/providers/amap/amap-provider.test.ts scripts/bounded-fetch-retry.test.mjs scripts/check-build-provider-isolation.test.mjs scripts/cloudbase-event-function-packaging.test.mjs scripts/cloudbase-run-source-submitter.test.mjs scripts/cloudbase-runtime-entrypoint.test.mjs scripts/compact-validation.test.mjs scripts/deploy-cloudbase-run-with-evidence.test.mjs scripts/describe-cloudbase-cam-login.test.mjs scripts/describe-cloudbase-function-invoke.test.mjs scripts/e2e-env-contract.test.mjs scripts/invoke-cloudbase-cleanup-http.test.mjs scripts/invoke-cloudbase-cleanup.test.mjs scripts/loopback-tls-proxy.test.mjs scripts/phase-4-storage-behavior.test.mjs scripts/phase-5-ci-contract.test.mjs scripts/phase-5-cn-browser-origin.test.mjs scripts/phase-5-environment.test.mjs scripts/phase-5-global-browser-smoke.test.mjs scripts/prepare-cloudbase-run.test.mjs scripts/verify-cloudbase-migration-plan.test.mjs scripts/verify-cloudbase-run-detail.test.mjs scripts/verify-cloudbase-run-health.test.mjs scripts/verify-cloudbase-run-records.test.mjs scripts/verify-vercel-git-deployment.test.mjs scripts/verify-vercel-preview-deployment.test.mjs scripts/verify-vercel-runtime-logs.test.mjs && npm run test:platform && npm run test:cloudbase-pg-static",
    "test:platform": "node --conditions=react-server --test src/platform/cloudbase/config.test.ts && node --test src/platform/platform.test.ts src/platform/cloudbase/access-token.test.ts src/platform/cloudbase/browser-phone-otp-provider.test.ts src/platform/cloudbase/browser-storage-provider.test.ts src/platform/cloudbase/mutations.test.ts src/platform/cloudbase/session.test.ts",
    "test:cloudbase-pg-rpc-surface": "node scripts/cloudbase-pg-live-rpc-surface.mjs",
    "test:cloudbase-pg-security": "node scripts/cloudbase-pg-live-rls.mjs",
    "test:cloudbase-phase-3-app-e2e": "node --env-file-if-exists=.env.local scripts/cloudbase-phase-3-app-e2e.mjs",
    "test:cloudbase-phase-3-live": "npm run test:cloudbase-pg-rpc-surface && npm run test:cloudbase-pg-security && npm run test:cloudbase-phase-3-app-e2e",
    "test:cloudbase-phase-4-storage": "node --env-file-if-exists=.env.local scripts/cloudbase-phase-4-storage-live.mjs",
    "test:cloudbase-phase-4-cleanup": "node --env-file-if-exists=.env.local scripts/cloudbase-phase-4-cleanup-live.mjs",
    "test:cloudbase-cn-feature-repair": "node --env-file-if-exists=.env.local scripts/cloudbase-cn-feature-repair-live.mjs",
    "test:supabase-phase-4-storage": "node --env-file-if-exists=.env.local scripts/supabase-phase-4-storage-live.mjs",
    "test:global-cookie-isolation": "node --env-file-if-exists=.env.local scripts/global-cookie-isolation-e2e.mjs",
    "test:global-phase-5-live": "node --env-file-if-exists=.env.local scripts/global-phase-5-live.mjs",
    "test:amap-phase-5-live": "node --env-file-if-exists=.env.local scripts/amap-phase-5-live.mjs",
    "test:cloudbase-pg-static": "node --test scripts/cloudbase-pg-security-regression.test.mjs",
    "test:e2e:preflight": "node scripts/e2e-regression.mjs --preflight --region all",
    "test:e2e:static": "node scripts/e2e-regression.mjs --static --region all",
    "test:e2e:clean": "node scripts/clean-validation-state.mjs",
    "test:e2e:global": "node scripts/e2e-regression.mjs --live --region global",
    "test:e2e:cn": "node scripts/e2e-regression.mjs --live --region cn",
    "test:e2e:all": "node scripts/e2e-regression.mjs --live --region all",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start",
    "test:telemetry": "node src/lib/telemetry/telemetry.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:cloudbase-pg-baseline": "node scripts/cloudbase-pg-baseline.mjs build",
    "build:cloudbase-pg-rpc-surface": "node scripts/cloudbase-pg-rpc-surface.mjs build",
    "build:database-pg-migrations": "node scripts/database-pg-migrations.mjs build",
    "new:database-pg-migration": "node scripts/database-pg-migrations.mjs new",
    "validate:public-templates": "node scripts/validate-public-templates.mjs"
  },
  "dependencies": {
    "@cloudbase/adapter-node": "2.0.0",
    "@cloudbase/js-sdk": "3.9.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@posthog/nextjs-config": "1.10.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "latest",
    "@vis.gl/react-google-maps": "1.9.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "html-to-image": "1.11.13",
    "lucide-react": "latest",
    "next": "16.2.12",
    "posthog-js": "1.421.2",
    "posthog-node": "5.51.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "9.2.1",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "latest",
    "tus-js-client": "4.3.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "latest",
    "typescript": "latest"
  }
}
